# ==========================================
# 1. Supabase (Auth + Cross-device Database)
# ==========================================
# Lấy tại: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==========================================
# 2. Google Gemini API Keys (Shared Pool)
# ==========================================
# Có thể nhập 1 key hoặc nhiều key phân tách bằng dấu phẩy để xoay vòng / dự phòng khi hết quota:
# Ví dụ: GEMINI_API_KEYS=AIzaSyKey1,AIzaSyKey2,AIzaSyKey3
GEMINI_API_KEYS=
# Hoặc dùng biến đơn nếu chỉ có 1 key:
GEMINI_API_KEY=

# Model ưu tiên (mặc định: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# 3. Bảo mật mã hóa API Key cá nhân (BYOK)
# ==========================================
# Chuỗi bí mật bất kỳ (tối thiểu 32 ký tự) để mã hóa AES-256-GCM khi người dùng lưu API Key riêng lên Supabase.
# Tạo nhanh bằng Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_SECRET=

# ==========================================
# 4. Tùy chọn bảo vệ Shared Pool
# ==========================================
# Số lượt gọi AI tối đa mỗi giờ cho mỗi người dùng khi xài key dùng chung của hệ thống (mặc định 60)
SHARED_POOL_HOURLY_LIMIT=60
